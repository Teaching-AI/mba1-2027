# ── LLM ───────────────────────────────────────────────────────────────────────
# gemini (clé AI Studio) · vertex (Google Cloud) · ollama (local) · fake (tests hors ligne)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PATH=./chroma_db

# ── Base de données annonces (Supabase) ───────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=eyJ...

# ── Admin (jeton exigé par POST /admin/sync, envoyé par Cloud Scheduler) ─────
ADMIN_TOKEN=changez-moi

# ── Frontend ──────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000

# ── Alertes (optionnel) ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
SLACK_WEBHOOK_URL=
